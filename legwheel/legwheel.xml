                    <site name="site_leftleg6_2" pos="-0.1014222117603 -0.005 -0.0271759997357" size="0.01" rgba="1 0 0 1"/>
                </body>

                <geom type="cylinder" fromto="0.0 -0.15 0 0.0 -0.16 0" size="0.020 " rgba="0.6 0.6 0.6 1" />
                <body name="rightleg1" pos="0.0547679943505 -0.165 -0.0146750398573" >
