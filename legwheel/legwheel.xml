                    <site name="site_rightleg6_1" pos="-0.0081137769408 0.005 -0.0021740799788" size="0.01" rgba="1 0 0 1"/>
                    <site name="site_rightleg6_2" pos="-0.1014222117603 0.005 -0.0271759997357" size="0.01" rgba="1 0 0 1"/>
                </body>
        </body>
    </worldbody>
    <equality>
        <connect site1="site_leftleg6_1" site2="site_leftleg3" solref="0.002 1"/>
        <connect site1="site_leftleg6_2" site2="site_leftleg5" solref="0.002 1"/>
        <connect site1="site_rightleg6_1" site2="site_rightleg3" solref="0.002 1"/>
        <connect site1="site_rightleg6_2" site2="site_rightleg5" solref="0.002 1"/>
    </equality>
    <actuator>
        <motor name="m1" joint="leftjoint1" gear="1"  ctrlrange="-50 50"/>
        <motor name="m2" joint="rightjoint1" gear="1"  ctrlrange="-50 50"/>
        <motor name="m3" joint="leftjoint6" gear="1"  ctrlrange="-50 50"/>
        <motor name="m4" joint="rightjoint6" gear="1"  ctrlrange="-50 50"/>
        <motor name="w1" joint="leftjoint1__2" gear="1"  ctrlrange="-5 5"/>
        <motor name="w2" joint="rightjoint1__2" gear="1"  ctrlrange="-5 5"/>
    </actuator>
    <sensor>

        <gyro name="body_gyro" site="imu_site"/>
        <framequat name="perfect_quat" objtype="site" objname="imu_site"/>
        <accelerometer name="body_accel" site="imu_site"/>
        <framepos name="perfect_pos" objtype="site" objname="imu_site"/>
        <framelinvel name="perfect_vel" objtype="site" objname="imu_site"/>
        <actuatorfrc name="motor_l1_force" actuator="m1"/>
        <actuatorfrc name="motor_r1_force" actuator="m2"/>
        <actuatorfrc name="motor_l2_force" actuator="m3"/>
        <actuatorfrc name="motor_r2_force" actuator="m4"/>
        <actuatorfrc name="wheel_l_force" actuator="w1"/>
        <actuatorfrc name="wheel_r_force" actuator="w2"/>
        <actuatorpos name="motor_l1_pos" actuator="m1"/>
        <actuatorvel  name="motor_l1_vel" actuator="m1"/>
        <actuatorpos name="motor_r1_pos" actuator="m2"/>
        <actuatorvel  name="motor_r1_vel" actuator="m2"/>
        <actuatorpos name="motor_l2_pos" actuator="m3"/>
        <actuatorvel  name="motor_l2_vel" actuator="m3"/>
        <actuatorpos name="motor_r2_pos" actuator="m4"/>
        <actuatorvel  name="motor_r2_vel" actuator="m4"/>
        <actuatorpos name="wheel_l_pos" actuator="w1"/>
        <actuatorvel name="wheel_l_vel" actuator="w1"/>
        <actuatorpos  name="wheel_r_pos" actuator="w2"/>
        <actuatorvel  name="wheel_r_vel" actuator="w2"/>
    </sensor>
