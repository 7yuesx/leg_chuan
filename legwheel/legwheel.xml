                        <geom type="box" size="0.074 0.005 0.0075" rgba="0.2 0.2 0.2 1" euler="0 -34.555326848126 0" density="7000"/>
                        <body name="leftleg3" pos="-0.1391107056504 -0.01 0.0203682158611" >
                            <joint name="leftjoint3" pos="0.084342711299 0 -0.0580871341226" type="hinge" axis="0 1 0"  damping="0.01"/>
                            <geom type="box" size="0.10991 0.005 0.0075" rgba="0.2 0.2 0.2 1" euler="0 34.555326848126 0" density="7000"/>
                            <site name="site_leftleg3" pos="-0.0251932774012 0.005 0.0173507024002" size="0.01" rgba="1 0 0 1"/>
                            <body name="leftleg4" pos="-0.1309969287096 -0.01 0.0455861742441" >
                                <joint name="leftjoint4" pos="0.0466542174097 0 0.0125009598784" type="hinge" axis="0 1 0"  damping="0.01"/>
                                <geom type="box" size="0.0558 0.005 0.0075" rgba="0.2 0.2 0.2 1" euler="0 -15 0" density="7000"/>
                                <body name="leftleg5" pos="0.0843427112999 0.01 -0.1027190243719">
                                    <joint name="leftjoint5" pos="-0.1309969287096 0 0.0902180644934" type="hinge" range="-28 70" axis="0 1 0"  damping="0.01"/>
                                    <geom type="box" size="0.1665581481481 0.005 0.0075" rgba="0.2 0.2 0.2 1" euler="0 34.555326848126 0" density="7000"/>
                                    <site name="site_leftleg5" pos="-0.071847494811 0.005 0.0494816327711" size="0.01" rgba="1 0 0 1"/>
                                    <body name="leftwheel1" pos="0.1309969287096 -0.015 -0.0902180644934">
                                        <joint name="leftjoint1__2" pos="0 0 0" type="hinge" axis="0 1 0" limited="false" damping="0.01"/>
                                        <geom type="cylinder" fromto="0 0 0 0 0.01 0" size="0.050 " rgba="1 1 1 1" condim="6" friction="0.8 0.005 0.0001 " density="4500" solref="0.005 1" solimp="0.9 0.95 0.001"/>
