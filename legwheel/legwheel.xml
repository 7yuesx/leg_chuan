<mujoco>
    <option timestep="0.002" integrator="RK4" />

    <asset>
        <!-- 最新方式：直接在XML中嵌入高程数据 -->
        
        <hfield name="my_terrain" 
                size="1 1 0.5 0.5" 
                nrow="2" 
                ncol="2" 
                elevation="1.0 1.0 1.0 1.0"/>
    </asset>

    <worldbody>
