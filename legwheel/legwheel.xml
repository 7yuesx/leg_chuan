                <body name="leftleg1" pos="0.0547679943505 0.165 -0.0146750398573" >
                    <joint name="leftjoint1" pos="-0.0547679943505 0 0.0146750398573" type="hinge" axis="0 1 0"  ref="15" damping="0.05"/>
                    <geom type="box" size="0.0642 0.005 0.0075" rgba="0.4 0.4 0.4 1" euler="0 15 0" density="7000"/>
                    <body name="leftleg2" pos="0.0 0.01 -0.0523939581187" >
