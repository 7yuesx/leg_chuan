                </body>
                <body name="rightleg6" pos="-0.1014222117603 -0.175 -0.0271759997357" >
                    <joint name="rightjoint6" pos="0.1014222117603 0.0 0.0271759997357" type="hinge" axis="0 1 0" ref="165" damping="0.01"/>
